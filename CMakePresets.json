{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (with GMP/MPFR)",
      "description": "Build with GMP/MPFR native support",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BIGMATH_ENABLE_CUDA": "OFF",
        "USE_GMP": "ON"
      }
    },
    {
      "name": "noint128",
      "displayName": "Int128 only (no GMP/MPFR)",
      "description": "Build Int128 without GMP/MPFR dependencies",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BIGMATH_ENABLE_CUDA": "OFF",
        "USE_GMP": "OFF"
      }
    },
    {
      "name": "vcpkg",
      "displayName": "vcpkg (with GMP/MPFR)",
      "description": "Build using vcpkg-managed GMP/MPFR",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BIGMATH_ENABLE_CUDA": "OFF",
        "USE_GMP": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (with GMP/MPFR)",
      "description": "Debug build with GMP/MPFR",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BIGMATH_ENABLE_CUDA": "OFF",
        "USE_GMP": "ON"
      }
    },
    {
      "name": "cuda-linux-release",
      "displayName": "CUDA Linux Release",
      "description": "Build Linux x86-64 with CUDA, GMP, and MPFR",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CUDA_STANDARD": "17",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "BIGMATH_ENABLE_CUDA": "ON",
        "USE_GMP": "ON"
      }
    },
    {
      "name": "cuda-windows-msvc-release",
      "displayName": "CUDA Windows MSVC Release",
      "description": "Build Windows x86-64 with MSVC, CUDA, GMP, and MPFR",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CUDA_STANDARD": "17",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "BIGMATH_ENABLE_CUDA": "ON",
        "USE_GMP": "ON"
      }
    },
    {
      "name": "cuda-debug",
      "displayName": "CUDA Debug",
      "description": "Debug build with CUDA when running on a supported host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CUDA_STANDARD": "17",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "BIGMATH_ENABLE_CUDA": "ON",
        "USE_GMP": "ON"
      }
    }
  ]
}
